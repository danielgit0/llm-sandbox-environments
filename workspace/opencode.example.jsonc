// Reference only: OpenCode loads workspace/opencode.json.
// Copy a snippet into that file and adjust the punctuation.
//
// Every model below is a LiteLLM alias: its name must match model_name in
// litellm/config.yaml. The sandbox has no other model egress path.
{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/deepseek-flash",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "{env:LITELLM_BASE_URL}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash (hosted)",
          "limit": { "context": 1000000, "output": 393216 }
        }
      }
    }
  },
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": ["/usr/local/bin/codebase-memory-mcp"],
      "enabled": true,
      "timeout": 30000
    }
  }
}

// --- Another hosted provider through LiteLLM -------------------------------
// Add the deployment to litellm/config.yaml; the key stays on the host:
//
//    - model_name: openrouter-deepseek
//      litellm_params:
//        model: openrouter/deepseek/deepseek-chat
//        api_key: os.environ/OPENROUTER_API_KEY
//
// Then add the alias:
//
//    "openrouter-deepseek": {
//      "name": "DeepSeek via OpenRouter",
//      "limit": { "context": 163840, "output": 16384 }
//    }
//
// The sandbox still only reaches LiteLLM; no new egress rule is required.
