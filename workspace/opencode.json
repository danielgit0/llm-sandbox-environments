{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/deepseek-flash",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "{env:LITELLM_BASE_URL}"
      },
      "models": {
        "deepseek-flash": {
          "name": "DeepSeek V4.1 Flash (hosted)",
          "limit": {
            "context": 1000000,
            "output": 393216
          }
        }
      }
    }
  },
  "mcp": {
    "codebase-memory-mcp": {
      "type": "local",
      "command": [
        "/usr/local/bin/codebase-memory-mcp"
      ],
      "enabled": true,
      "timeout": 30000
    }
  }
}
