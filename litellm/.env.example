# Copy to .env (gitignored) only if you need optional secrets.
# Required LiteLLM settings live in run.sh; sandbox settings live in
# envs/opencode*.yaml.

# Required for the DSH ACP default model; also used if OpenCode selects
# DeepSeek. The local Ollama alias needs no key because Ollama runs on this
# host at 127.0.0.1:11434.
DEEPSEEK_API_KEY=
