# Copy to .env (gitignored) only if you need optional secrets.
# Required LiteLLM settings live in run.sh; sandbox settings live in sbxenv.yaml.

# Required for the DSH ACP default model; also used if OpenCode selects DeepSeek.
DEEPSEEK_API_KEY=

# Optional host Flutter MCP bridge. flutter-mcp/run.sh reads this file.
# FLUTTER_PROJECT=/absolute/path/to/flutter-app
# FLUTTER_DART=/absolute/path/to/flutter/bin/dart
